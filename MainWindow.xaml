<Window x:Class="ImageTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tm="clr-namespace:ImageTools.Treemap"
        Title="Image Tools"
        Icon="Assets/app.ico"
        Width="1440" Height="900" MinWidth="1200" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Theme brushes and the Icons font live in the application resources (see App.ApplyTheme). -->

        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Four tabs with counts have to fit the 400px side panel on one row. -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- A flat, full-width clickable row (card locations). -->
        <Style x:Key="LinkRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LinkHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <EventSetter Event="MouseEnter" Handler="Row_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Row_MouseLeave" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
        </Style>

        <!-- Shared by the Contents and Libraries lists. -->
        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Drive health: green / yellow / red strip (drives only) -->
                <Border Grid.RowSpan="4" Width="4" CornerRadius="2" Margin="0,1,9,1" Background="{Binding HealthBrush}"
                        Visibility="{Binding HealthVisibility}" ToolTip="{Binding HealthText}" />
                <Grid Grid.Column="1" Margin="0,0,9,0" VerticalAlignment="Center" MinWidth="11">
                    <Border Width="11" Height="11" CornerRadius="2" Visibility="{Binding SwatchVisibility}"
                            Background="{Binding SwatchFill}" BorderBrush="{Binding SwatchStroke}" BorderThickness="{Binding SwatchThickness}" />
                    <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}" FontFamily="{StaticResource Icons}"
                               FontSize="15" Foreground="{Binding GlyphInk}" />
                </Grid>
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding AlertVisibility}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding AlertGlyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                                   Foreground="{Binding HealthBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HealthText}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding NameWeight}" />
                </DockPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Margin="10,0,0,0" />
                <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Height="3" Margin="0,4,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding BarFilled}" />
                        <ColumnDefinition Width="{Binding BarEmpty}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource BarTrack}" CornerRadius="1.5" />
                    <Border Background="{Binding BarBrush}" CornerRadius="1.5" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Detail}"
                           FontSize="11" Foreground="{DynamicResource InkMuted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Detail2}" Visibility="{Binding Detail2Visibility}"
                           FontSize="11" Foreground="{DynamicResource InkMuted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail2}" Margin="0,1,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Shared by the Duplicates and Folder matches cards. -->
        <DataTemplate x:Key="CardTemplate">
            <Border Margin="2,0,2,8" Padding="12,10,12,6" CornerRadius="6" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding BadgeGlyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                                   Foreground="{Binding BadgeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,6"
                               Foreground="{DynamicResource InkSecondary}" />
                    <ItemsControl ItemsSource="{Binding Locations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkRow}" Tag="{Binding Node}" Click="CardLocation_Click"
                                        ToolTip="{Binding Path}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource InkMuted}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoreText}" Visibility="{Binding MoreVisibility}" FontSize="11"
                               Foreground="{DynamicResource InkMuted}" Margin="4,2,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="{Binding ExplorerText}"
                                Tag="{Binding}" Click="CardExplorer_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
            <DockPanel LastChildFill="True">
                <Button x:Name="UpButton" DockPanel.Dock="Left" Click="Up_Click" ToolTip="Up one level (Backspace)"
                        Padding="10,6" IsEnabled="False">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74A;" FontSize="14" />
                </Button>
                <Button x:Name="RescanButton" DockPanel.Dock="Left" Margin="6,0,2,0" Click="ScanForNew_Click"
                        ToolTip="Look for new and changed images on every drive, including cards just plugged in (F5). Only those images are read; everything else comes from the cache."
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Scan for new" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScanMenuButton" DockPanel.Dock="Left" Margin="0,0,6,0" Click="ScanMenu_Click" Padding="7,6"
                        ToolTip="More scan options, including a full rescan">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="DrivesButton" DockPanel.Dock="Left" Margin="0,0,6,0" Click="DrivesButton_Click" Padding="10,6"
                        ToolTip="Choose which drives to scan. Network and cloud drives are skipped unless you include them.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEDA2;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Drives" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="10" Margin="7,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ElevateButton" DockPanel.Dock="Left" Margin="0,0,14,0" Click="Elevate_Click" Padding="10,6"
                        ToolTip="Restart with administrator rights to include folders a normal user can't read (other users' profiles, …). The app stays read-only.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Run as admin" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border x:Name="AdminBadge" DockPanel.Dock="Left" Visibility="Collapsed" Margin="0,0,14,0" Padding="10,5"
                        CornerRadius="4" Background="{DynamicResource BadgeBg}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentInk}" />
                        <TextBlock Text="Administrator" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentInk}" />
                    </StackPanel>
                </Border>

                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Click="Theme_Click" Padding="10,6" Margin="10,0,0,0">
                    <TextBlock x:Name="ThemeGlyph" FontFamily="{StaticResource Icons}" FontSize="14" Text="&#xE708;" />
                </Button>
                <CheckBox x:Name="AssetsCheck" DockPanel.Dock="Right" Content="App assets" IsChecked="False"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Show icons, textures and other images that belong to apps and games. They're never checked for duplicates."
                          Checked="Assets_Changed" Unchecked="Assets_Changed" />
                <ComboBox x:Name="ColorModeBox" DockPanel.Dock="Right" Width="168" Margin="10,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="ColorMode_Changed" ToolTip="Color images by duplicate status, library, format or date taken">
                    <ComboBoxItem Content="Color: Duplicates" IsSelected="True" />
                    <ComboBoxItem Content="Color: Library" />
                    <ComboBoxItem Content="Color: Format" />
                    <ComboBoxItem Content="Color: Date" />
                </ComboBox>
                <Grid DockPanel.Dock="Right" Width="270" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Padding="32,5,8,6" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             ToolTip="Name contains text · IMG_*.jpg / DSC0?.NEF wildcards · .heic extension  (Ctrl+F, Esc to clear)" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource InkMuted}" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search: name, IMG_*.jpg, .heic" IsHitTestVisible="False"
                               Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource InkMuted}" />
                </Grid>
                <TextBlock x:Name="SearchSummary" DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkSecondary}" Margin="10,0,0,0" />

                <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Map + side panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,8,0,8">
                <tm:TreemapControl x:Name="Map" Cursor="Hand" />
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="Tip" Visibility="Collapsed" Background="{DynamicResource TipBg}" BorderBrush="{DynamicResource TipBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="12,9" MaxWidth="440">
                        <StackPanel>
                            <Image x:Name="TipImage" Visibility="Collapsed" MaxWidth="240" MaxHeight="180" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="TipTitle" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TipSize" Foreground="{DynamicResource InkPrimary}" Margin="0,3,0,0" />
                            <TextBlock x:Name="TipDetail" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="TipAge" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="TipPath" Foreground="{DynamicResource InkMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="TipHint" Foreground="{DynamicResource AccentInk}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Column="2" Margin="0,8,8,8">
                <StackPanel DockPanel.Dock="Top" Margin="6,2,6,8">
                    <TextBlock x:Name="ViewTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ViewSubtitle" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Grid x:Name="ViewCapacity" Height="6" Margin="0,8,0,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CapacityUsed" Width="0*" />
                            <ColumnDefinition x:Name="CapacityFree" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{DynamicResource BarTrack}" CornerRadius="3" />
                        <Border x:Name="CapacityBar" CornerRadius="3" Background="{DynamicResource AccentFill}" />
                    </Grid>

                    <!-- Camera cards with images that aren't in their archive folders yet -->
                    <ItemsControl x:Name="ImportBanners" Margin="-4,10,-4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,10,12,4" CornerRadius="6" Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7F1;" FontFamily="{StaticResource Icons}" FontSize="15" Margin="0,1,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="10,0,0,0" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                                                       Foreground="{Binding BadgeBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,6"
                                                   Foreground="{DynamicResource InkSecondary}" />
                                        <WrapPanel Visibility="{Binding ReviewVisibility}">
                                            <Button Style="{StaticResource SmallButton}" Content="Review import…" Tag="{Binding Status}"
                                                    Click="ReviewImport_Click"
                                                    ToolTip="Choose images and preview exactly what would be copied. Nothing changes until you apply." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Legend -->
                <Border x:Name="LegendPanel" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}"
                        Padding="6,8,6,0" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LegendTitle" Text="IMAGES BY DUPLICATE STATUS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkMuted}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="Legend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Swatch}"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" Foreground="{DynamicResource InkMuted}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TabControl x:Name="SideTabs" SelectionChanged="SideTabs_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
                    <!-- Contents of the current folder -->
                    <TabItem x:Name="ContentsTab" Header="Contents">
                        <ListBox x:Name="ContentsList" ItemContainerStyle="{StaticResource RowStyle}" ItemTemplate="{StaticResource RowTemplate}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown" />
                    </TabItem>

                    <!-- Byte-identical images, biggest waste first -->
                    <TabItem x:Name="DupesTab" Header="Duplicates">
                        <DockPanel>
                            <TextBlock x:Name="DupesSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="6,2,6,8"
                                       Foreground="{DynamicResource InkSecondary}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <ItemsControl x:Name="DupesList" ItemTemplate="{StaticResource CardTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Folders that hold the same images -->
                    <TabItem x:Name="MatchesTab" Header="Matches">
                        <DockPanel>
                            <TextBlock x:Name="MatchesSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="6,2,6,8"
                                       Foreground="{DynamicResource InkSecondary}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                <ItemsControl x:Name="MatchesList" ItemTemplate="{StaticResource CardTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Where images come from: Screenshots, DCIM, WhatsApp… -->
                    <TabItem x:Name="LibrariesTab" Header="Libraries">
                        <DockPanel>
                            <TextBlock x:Name="LibrariesSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="6,2,6,6"
                                       FontSize="11" Foreground="{DynamicResource InkMuted}" />
                            <ListBox x:Name="LibrariesList" ItemContainerStyle="{StaticResource RowStyle}" ItemTemplate="{StaticResource RowTemplate}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource InkMuted}" Margin="16,0,0,0"
                           Text="Click: zoom in  ·  Right-click: options  ·  Backspace: up  ·  Ctrl+F: search  ·  F5: scan for new" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource InkSecondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
