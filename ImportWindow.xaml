<Window x:Class="ImageTools.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageTools"
        Title="Import from camera card"
        Icon="Assets/app.ico"
        Width="980" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- A virtualizing list without selection: thousands of rows for a full card stay fast. -->
        <Style x:Key="FlatList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select step: a folder pair, then its sections, then image rows. -->
        <DataTemplate DataType="{x:Type local:FolderHeader}">
            <StackPanel Margin="16,16,16,4">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PathLine}" FontSize="11" Foreground="{DynamicResource InkMuted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PathLine}" />
                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource InkSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:BucketHeader}">
            <StackPanel Margin="16,10,16,4">
                <TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ImportRow}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" Foreground="{DynamicResource InkSecondary}" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                <TextBlock Grid.Column="4" Text="{Binding Note}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource InkMuted}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
            </Grid>
        </DataTemplate>

        <!-- Preview step: one row per change. -->
        <DataTemplate DataType="{x:Type local:ChangeRow}">
            <Grid Margin="16,3,16,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,2,10,0"
                           Foreground="{Binding GlyphBrush}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource InkMuted}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource AccentInk}" Visibility="{Binding NoteVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderSubtitle" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Step 1: choose images -->
        <DockPanel x:Name="SelectPanel" Grid.Row="1">
            <Border DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                <DockPanel>
                    <CheckBox x:Name="SelectAllCheck" DockPanel.Dock="Left" Content="Select all (full card → archive sync)"
                              ToolTip="Tick every image below, including older ones and ones already elsewhere. Untick to go back to just the new images."
                              Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
                    <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{DynamicResource InkSecondary}" />
                </DockPanel>
            </Border>
            <ItemsControl x:Name="RowsList" Style="{StaticResource FlatList}" Padding="0,0,0,12" />
        </DockPanel>

        <!-- Step 2: preview changes -->
        <DockPanel x:Name="PreviewPanel" Grid.Row="1" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                <StackPanel x:Name="PreviewSummary" />
            </Border>
            <ItemsControl x:Name="ChangesList" Style="{StaticResource FlatList}" Padding="0,8,0,12" />
        </DockPanel>

        <!-- Step 3: copying, then the results -->
        <DockPanel x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Height="6" Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ProgressDone" Width="0*" />
                            <ColumnDefinition x:Name="ProgressLeft" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{DynamicResource BarTrack}" CornerRadius="3" />
                        <Border x:Name="ProgressFill" CornerRadius="3" Background="{DynamicResource AccentFill}" />
                    </Grid>
                    <TextBlock x:Name="ProgressDetail" FontSize="11" Foreground="{DynamicResource InkMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <ItemsControl x:Name="ResultsList" Style="{StaticResource FlatList}" Padding="0,8,0,12" />
        </DockPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}">
            <DockPanel>
                <StackPanel x:Name="SelectButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="PreviewButton" Content="Preview changes" Padding="14,6" IsDefault="True" Click="Preview_Click" />
                </StackPanel>
                <StackPanel x:Name="PreviewButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Back" Padding="14,6" Margin="0,0,8,0" Click="Back_Click" />
                    <Button Content="Copy report" Padding="14,6" Margin="0,0,8,0" Click="CopyReport_Click"
                            ToolTip="Copy this list of changes to the clipboard" />
                    <Button x:Name="ApplyButton" Content="Apply changes" Padding="14,6" Click="Apply_Click"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Copies only: nothing on the card is changed or deleted, and nothing in the archive is overwritten. Every copy is checked against the original." />
                </StackPanel>
                <StackPanel x:Name="CopyingButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="StopButton" Content="Stop" Padding="14,6" Click="Stop_Click"
                            ToolTip="Stop after the file being copied now. Files already copied stay where they are." />
                </StackPanel>
                <StackPanel x:Name="DoneButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="OpenLogButton" Content="Open log" Padding="14,6" Margin="0,0,8,0" Click="OpenLog_Click" />
                    <Button Content="Close" Padding="14,6" IsDefault="True" Click="Close_Click" />
                </StackPanel>
                <TextBlock x:Name="FooterNote" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource InkMuted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
