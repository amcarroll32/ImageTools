<Window x:Class="ImageTools.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive folder"
        Icon="Assets/app.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True">
    <StackPanel>
        <StackPanel Margin="20,18,20,16">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- Before and after, side by side -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12,10" CornerRadius="6" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="NOW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}" />
                        <TextBlock x:Name="BeforePath" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="BeforeDetail" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12,10" CornerRadius="6" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource AccentFill}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AFTER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}" />
                        <TextBlock x:Name="AfterPath" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="AfterDetail" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl x:Name="WarningList" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,2,10,0" Foreground="{Binding Brush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="12" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Nothing is copied, moved or deleted. This only changes where Image Tools looks for this card folder's photos and where an import would put them – every copy still goes through Preview changes." />
        </StackPanel>
        <Border Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" IsDefault="True" />
                <Button x:Name="ConfirmButton" Padding="14,6" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
