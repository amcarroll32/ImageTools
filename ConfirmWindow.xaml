<Window x:Class="ImageTools.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True">
    <StackPanel>
        <StackPanel Margin="20,18,20,16">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Border x:Name="WarningPanel" Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WarningGlyph" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,2,10,0" />
                    <TextBlock x:Name="WarningText" Grid.Column="1" TextWrapping="Wrap" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </StackPanel>
        <Border Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" IsDefault="True" />
                <Button x:Name="ConfirmButton" Padding="14,6" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
